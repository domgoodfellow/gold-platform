# =============================================================================
# GOLD WEB - ENVIRONMENT CONTRACT
# =============================================================================
#
# LOCAL DEVELOPMENT
# -----------------
# Copy this file to:
#
#   apps/web/.env.local
#
# Real local values belong in .env.local and are ignored by Git.
#
# VERCEL
# ------
# Add these same variable names in the Vercel Web project's:
#
#   Settings > Environment Variables
#
# Use Preview for staging/test resources and Production for live resources.
# Vercel Sensitive mode is available for Preview and Production only, not
# Development.

# Supabase project API URL.
#
# Secret: NO
# Vercel Sensitive: NO
# Browser-visible: YES
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anon/public key. The current source reads this exact variable name.
#
# Secret: NO
# Vercel Sensitive: NO
# Browser-visible: YES
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical public origin for GOLD's website, sitemap, and social metadata.
# Do not include a path. Vercel's production project URL is used when this is absent;
# local development falls back to http://localhost:3000.
#
# Secret: NO
# Vercel Sensitive: NO
# Browser-visible: NO
SITE_URL=

# Public base URL of apps/api, used by the Ask feature.
#
# Secret: NO
# Vercel Sensitive: NO
# Browser-visible: NO
ASSISTANT_API_URL=

# Shared server-to-server key for the tool-free public website assistant. Set the same value in
# apps/api; it is never browser-visible.
PUBLIC_CHAT_API_SECRET=

# Public base URL of apps/api, used by apps/web/lib/api for migrated FastAPI domain commands
# (changing a customer's pipeline stage, writing up a call). Usually the same deployment as
# ASSISTANT_API_URL above — kept as its own variable because the two features are separately
# configurable, the same reasoning apps/api/app/core/config.py gives for its own settings
# dataclasses.
#
# Secret: NO
# Vercel Sensitive: NO
# Browser-visible: NO
GOLD_API_URL=

# Contact identity for geocoding provider usage-policy compliance.
#
# Secret: NO
# Vercel Sensitive: NO
# Browser-visible: NO
GEOCODING_CONTACT=

# Basemap style document URL for the Locations Map view's MapLibre GL renderer. A style URL,
# never a vendor SDK key. A separate concern from GEOCODING_CONTACT above: that turns an address
# into coordinates, server-side; this turns already-stored coordinates into a picture in the
# browser. Unconfigured means the Map view explains itself ("Map rendering is not configured for
# this deployment") rather than falling back to a public tile host as production infrastructure;
# List stays fully usable either way.
#
# Local development only — not a production commitment, and MapLibre's own demo tiles are not an
# unlimited SaaS basemap service:
#   https://demotiles.maplibre.org/style.json
#
# Secret: NO
# Vercel Sensitive: NO
# Browser-visible: YES
NEXT_PUBLIC_MAP_STYLE_URL=

# Stripe Connect platform secret key.
#
# Preview/local: sk_test_...
# Production:    sk_live_...
#
# Secret: YES
# Vercel Sensitive Preview/Production: YES
# Vercel Sensitive Development: N/A
# Browser-visible: NO
STRIPE_SECRET_KEY=

# Stripe Connect application/client identifier.
#
# Format: ca_...
#
# Secret: NO
# Vercel Sensitive: NO
# Browser-visible: NO
STRIPE_CONNECT_CLIENT_ID=

# GOLD master Twilio Account SID.
#
# Secret: NO
# Vercel Sensitive: NO
# Browser-visible: NO
TWILIO_ACCOUNT_SID=

# GOLD master Twilio Auth Token.
#
# Secret: YES
# Vercel Sensitive Preview/Production: YES
# Vercel Sensitive Development: N/A
# Browser-visible: NO
TWILIO_AUTH_TOKEN=

# Twilio API Key SID for browser Voice SDK access tokens.
#
# Secret: NO
# Vercel Sensitive: NO
# Browser-visible: NO
TWILIO_API_KEY_SID=

# Secret half of the Twilio API key above.
#
# Secret: YES
# Vercel Sensitive Preview/Production: YES
# Vercel Sensitive Development: N/A
# Browser-visible: NO
TWILIO_API_KEY_SECRET=

# TwiML Application used for browser calling.
#
# Secret: NO
# Vercel Sensitive: NO
# Browser-visible: NO
TWILIO_TWIML_APP_SID=

# Public base URL of apps/api used for Twilio callbacks.
#
# Secret: NO
# Vercel Sensitive: NO
# Browser-visible: NO
TELEPHONY_CALLBACK_URL=

# Resend API key for GOLD's own transactional email (organization invitations).
# A separate concern from apps/api's tenant-channel Resend key, even if the same
# Resend account issues both in practice — GOLD's own platform mail must never be
# confused with a tenant's metered, billed sends.
#
# Secret: YES
# Vercel Sensitive Preview/Production: YES
# Vercel Sensitive Development: N/A
# Browser-visible: NO
RESEND_API_KEY=

# The "from" address GOLD's own invitation emails are sent as. Unconfigured means
# invitations still work — the copyable link is always shown regardless — but no
# email is attempted.
#
# Secret: NO
# Vercel Sensitive: NO
# Browser-visible: NO
PLATFORM_EMAIL_FROM_ADDRESS=

# Google Sign-In credentials are intentionally absent. Hosted Google auth is
# configured in Supabase Auth provider settings, not Vercel.
