{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx --yes pnpm@11.4.0 install --filter @gold/integration-library --ignore-scripts --frozen-lockfile",
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{tests/**,dev.py,node_modules/**,library/*.mjs,invoice_documents/**}",
      "maxDuration": 300
    },
    "api/library_runtime.mjs": {
      "maxDuration": 60
    },
    "api/invoice_documents.mjs": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/tasks/customer-notifications",
      "destination": "/api/customer_notification_tick"
    },
    {
      "source": "/integrations/library",
      "destination": "/api/app_library"
    },
    {
      "source": "/integrations/library-runtime",
      "destination": "/api/library_runtime"
    },
    {
      "source": "/tasks/integration-sync",
      "destination": "/api/integration_sync_tick"
    },
    {
      "source": "/webhooks/stripe",
      "destination": "/api/stripe_webhook"
    },
    {
      "source": "/tasks/automation-tick",
      "destination": "/api/automation_tick"
    },
    {
      "source": "/ai/ask",
      "destination": "/api/ai_ask"
    },
    {
      "source": "/ai/draft-configuration",
      "destination": "/api/ai_draft_configuration"
    },
    {
      "source": "/voice/outbound",
      "destination": "/api/voice_outbound"
    },
    {
      "source": "/voice/inbound",
      "destination": "/api/voice_inbound"
    },
    {
      "source": "/voice/status",
      "destination": "/api/voice_status"
    },
    {
      "source": "/voice/recording",
      "destination": "/api/voice_recording"
    },
    {
      "source": "/providers/operate",
      "destination": "/api/provider_operations"
    },
    {
      "source": "/organizations/domains",
      "destination": "/api/organization_domains"
    },
    {
      "source": "/organizations/email-domains",
      "destination": "/api/organization_email_domains"
    },
    {
      "source": "/integrations/operate",
      "destination": "/api/integration_operations"
    },
    {
      "source": "/crm/change-customer-stage",
      "destination": "/api/crm_change_customer_stage"
    },
    {
      "source": "/voice/wrap-up-call",
      "destination": "/api/voice_wrap_up_call"
    },
    {
      "source": "/routing/preview-inbound",
      "destination": "/api/routing_preview_inbound"
    },
    {
      "source": "/routing/preview-outbound",
      "destination": "/api/routing_preview_outbound"
    },
    {
      "source": "/sms/inbound",
      "destination": "/api/sms_inbound"
    },
    {
      "source": "/sms/status",
      "destination": "/api/sms_status"
    },
    {
      "source": "/webhooks/stripe-platform-billing",
      "destination": "/api/stripe_platform_billing_webhook"
    },
    {
      "source": "/platform-billing/customer",
      "destination": "/api/platform_billing_customer"
    },
    {
      "source": "/public_chat",
      "destination": "/api/public_chat"
    },
    {
      "source": "/invitations/email",
      "destination": "/api/invitation_email"
    },
    {
      "source": "/email/test-send",
      "destination": "/api/email_test_send"
    },
    {
      "source": "/platform/email-readiness",
      "destination": "/api/platform_email_readiness"
    },
    {
      "source": "/webhooks/invitation-email",
      "destination": "/api/invitation_email_webhook"
    },
    {
      "source": "/communications/email/send",
      "destination": "/api/tenant_email_send"
    },
    {
      "source": "/webhooks/tenant-email",
      "destination": "/api/tenant_email_webhook"
    },
    {
      "source": "/voice/agent/events",
      "destination": "/api/voice_agent_events"
    },
    {
      "source": "/invoice-documents",
      "destination": "/api/invoice_documents"
    }
  ],
  "crons": [
    {
      "path": "/tasks/customer-notifications",
      "schedule": "* * * * *"
    },
    {
      "path": "/tasks/integration-sync",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/tasks/automation-tick",
      "schedule": "*/15 * * * *"
    }
  ]
}
