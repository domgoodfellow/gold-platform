{
  "functions": {
    "app/api/*.py": {
      "runtime": "@vercel/python@4.3.0"
    }
  },
  "rewrites": [
    {
      "source": "/webhooks/stripe",
      "destination": "/app/api/stripe_webhook"
    },
    {
      "source": "/tasks/automation-tick",
      "destination": "/app/api/automation_tick"
    },
    {
      "source": "/ai/ask",
      "destination": "/app/api/ai_ask"
    },
    {
      "source": "/voice/outbound",
      "destination": "/app/api/voice_outbound"
    },
    {
      "source": "/voice/inbound",
      "destination": "/app/api/voice_inbound"
    },
    {
      "source": "/voice/status",
      "destination": "/app/api/voice_status"
    },
    {
      "source": "/voice/recording",
      "destination": "/app/api/voice_recording"
    }
  ],
  "crons": [
    {
      "path": "/tasks/automation-tick",
      "schedule": "*/15 * * * *"
    }
  ]
}
