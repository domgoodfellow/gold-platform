{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/webhooks/stripe",
      "destination": "/api/stripe_webhook"
    },
    {
      "source": "/tasks/automation-tick",
      "destination": "/api/automation_tick"
    },
    {
      "source": "/ai/ask",
      "destination": "/api/ai_ask"
    },
    {
      "source": "/voice/outbound",
      "destination": "/api/voice_outbound"
    },
    {
      "source": "/voice/inbound",
      "destination": "/api/voice_inbound"
    },
    {
      "source": "/voice/status",
      "destination": "/api/voice_status"
    },
    {
      "source": "/voice/recording",
      "destination": "/api/voice_recording"
    }
  ],
  "crons": [
    {
      "path": "/tasks/automation-tick",
      "schedule": "*/15 * * * *"
    }
  ]
}
