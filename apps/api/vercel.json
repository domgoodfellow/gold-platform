{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/**/*.py": {
      "excludeFiles": "{tests/**,dev.py}"
    }
  },
  "rewrites": [
    {
      "source": "/webhooks/stripe",
      "destination": "/api/stripe_webhook"
    },
    {
      "source": "/tasks/automation-tick",
      "destination": "/api/automation_tick"
    },
    {
      "source": "/ai/ask",
      "destination": "/api/ai_ask"
    },
    {
      "source": "/voice/outbound",
      "destination": "/api/voice_outbound"
    },
    {
      "source": "/voice/inbound",
      "destination": "/api/voice_inbound"
    },
    {
      "source": "/voice/status",
      "destination": "/api/voice_status"
    },
    {
      "source": "/voice/recording",
      "destination": "/api/voice_recording"
    },
    {
      "source": "/providers/operate",
      "destination": "/api/provider_operations"
    },
    {
      "source": "/crm/change-customer-stage",
      "destination": "/api/crm_change_customer_stage"
    },
    {
      "source": "/voice/wrap-up-call",
      "destination": "/api/voice_wrap_up_call"
    }
  ],
  "crons": [
    {
      "path": "/tasks/automation-tick",
      "schedule": "*/15 * * * *"
    }
  ]
}
