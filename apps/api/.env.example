# =============================================================================
# GOLD API — ENVIRONMENT CONTRACT
# =============================================================================
#
# LOCAL DEVELOPMENT
# -----------------
# Copy this file to:
#
#   apps/api/.env
#
# apps/api/dev.py reads apps/api/.env.
#
# Do NOT use apps/api/.env.local as the GOLD API configuration file.
#
# If Vercel CLI created apps/api/.env.local containing VERCEL_OIDC_TOKEN,
# that is Vercel's own local OIDC state, not GOLD configuration.
#
#
# VERCEL
# ------
# Do NOT upload apps/api/.env.
#
# Add these SAME variable names directly in the Vercel API project's:
#
#   Settings > Environment Variables
#
# Vercel supplies different VALUES depending on deployment environment:
#
#   Preview    -> staging/test resources
#   Production -> production/live resources
#
# There are no .env.preview or .env.production files in this repository.
#
#
# IMPORTANT SUPABASE NOTE
# -----------------------
# GOLD is migrating to Supabase's current publishable-key architecture.
#
# SUPABASE_ANON_KEY has therefore been renamed:
#
#   SUPABASE_PUBLISHABLE_KEY
#
# and should contain:
#
#   sb_publishable_...
#
# The API still contains one SEPARATE legacy machine-auth dependency,
# SUPABASE_JWT_SECRET. That dependency is clearly marked below.
#
# Do not populate that variable in the new hosted environment unless we
# intentionally choose to run the old machine-token implementation.
# We will remove it from the source in the machine-auth migration.
# =============================================================================


# -----------------------------------------------------------------------------
# SUPABASE — REQUIRED FOR SUPABASE-BACKED API FEATURES
# -----------------------------------------------------------------------------

# Supabase project API URL.
#
# LOCAL:
#   http://127.0.0.1:54321
#
# PREVIEW:
#   GOLD staging Supabase project
#
# PRODUCTION:
#   GOLD production Supabase project
#
# Source:
#   Local       -> `pnpm db:start`
#   Hosted      -> Supabase Dashboard > Connect
#
# Secret: NO
# Vercel Sensitive: NO
SUPABASE_URL=http://127.0.0.1:54321


# Supabase's modern low-privilege API key.
#
# Format:
#   sb_publishable_...
#
# This replaces the legacy SUPABASE_ANON_KEY variable.
#
# Although apps/api runs server-side, this particular key remains deliberately
# low privilege. User-facing API operations continue under the signed-in user's
# Auth JWT and Row Level Security.
#
# Direct PostgREST requests still send this value in the `apikey` header.
#
# Source:
#   Local       -> `pnpm db:start`
#   Hosted      -> Supabase Dashboard > Connect
#                  or Settings > API Keys > Publishable key
#
# Secret: NO
# Vercel Sensitive: NO
SUPABASE_PUBLISHABLE_KEY=


# -----------------------------------------------------------------------------
# TEMPORARY LEGACY MACHINE-AUTH DEPENDENCY
# -----------------------------------------------------------------------------
#
# CURRENT SOURCE STATUS:
#
# The existing payment_webhook, automation_runner and voice_webhook code
# currently mints short-lived custom HS256 JWTs using Supabase's old shared JWT
# signing secret.
#
# This is NOT the anon key.
# This is NOT the service-role key.
# This is NOT an sb_secret_ key.
#
# We have explicitly chosen to migrate away from this mechanism.
#
# Therefore:
#
#   - keep the variable documented temporarily while the source still reads it;
#   - LEAVE IT EMPTY in the new hosted configuration for now;
#   - do NOT substitute SUPABASE_SECRET_KEY / sb_secret_ as a shortcut;
#   - remove this variable entirely once the machine-auth code migration lands.
#
# Leaving it unset means the current machine-only endpoints that require it
# remain unconfigured rather than silently gaining excessive privileges.
#
# Secret: YES
# Vercel Sensitive: YES
# TEMPORARY / DO NOT CONFIGURE YET
SUPABASE_JWT_SECRET=


# -----------------------------------------------------------------------------
# STRIPE WEBHOOK
# -----------------------------------------------------------------------------

# Signing secret for GOLD's Stripe webhook endpoint.
#
# This is NOT the Stripe API secret key.
#
# LOCAL:
#   Run Stripe CLI, for example:
#
#     stripe listen --forward-to http://127.0.0.1:8787/webhooks/stripe
#
#   The CLI prints a temporary whsec_ value.
#
# PRODUCTION:
#   Stripe Dashboard > Developers > Webhooks
#   > production GOLD endpoint > Signing secret
#
# Preview/staging should use its own test endpoint and signing secret.
#
# Format:
#   whsec_...
#
# Secret: YES
# Vercel Sensitive: YES
STRIPE_WEBHOOK_SECRET=


# -----------------------------------------------------------------------------
# AUTOMATION SCHEDULER
# -----------------------------------------------------------------------------

# Shared random secret protecting:
#
#   /tasks/automation-tick
#
# This is generated by YOU — it does not come from Supabase or another vendor.
#
# Generate a strong value, e.g. PowerShell:
#
#   [Convert]::ToHexString(
#     [Security.Cryptography.RandomNumberGenerator]::GetBytes(32)
#   )
#
# Use a separate value for staging and production if both environments can
# invoke the endpoint.
#
# Vercel Cron normally invokes the Production deployment.
#
# Secret: YES
# Vercel Sensitive: YES
CRON_SECRET=


# -----------------------------------------------------------------------------
# EMAIL — RESEND
# -----------------------------------------------------------------------------

# GOLD's Resend API credential.
#
# Source:
#   Resend Dashboard > API Keys
#
# Format:
#   re_...
#
# Production should use the production credential.
# Staging should ideally use a restricted/staging credential.
#
# Secret: YES
# Vercel Sensitive: YES
RESEND_API_KEY=


# Default GOLD platform sender address.
#
# Must belong to a domain/subdomain verified with Resend.
#
# Example:
#   notifications@example.com
#
# This is an address, not a credential.
#
# Secret: NO
# Vercel Sensitive: NO
MESSAGE_FROM_ADDRESS=


# -----------------------------------------------------------------------------
# TWILIO — MESSAGING / CALLBACK VERIFICATION
# -----------------------------------------------------------------------------

# GOLD master Twilio Account SID.
#
# Must correspond to the same account used by apps/web for the same
# environment.
#
# Format:
#   ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Source:
#   Twilio Console > Account SID
#
# Secret: NO
# Vercel Sensitive: NO
TWILIO_ACCOUNT_SID=


# GOLD master Twilio Auth Token.
#
# Used by current Twilio integration code for authenticated provider calls and
# callback-signature verification.
#
# Source:
#   Twilio Console > Auth Token
#
# Secret: YES
# Vercel Sensitive: YES
TWILIO_AUTH_TOKEN=


# Current deployment-level SMS sender number.
#
# Tenant-specific communication resources are increasingly represented through
# GOLD's provider-resource model; this remains the current messaging fallback
# while that migration is completed.
#
# Format:
#   E.164, e.g. +15145551234
#
# Source:
#   Twilio Console > Phone Numbers
#
# Secret: NO
# Vercel Sensitive: NO
MESSAGE_FROM_NUMBER=


# -----------------------------------------------------------------------------
# AI — ANTHROPIC FALLBACK
# -----------------------------------------------------------------------------

# GOLD-owned Anthropic key.
#
# apps/api's answering layer is provider-neutral. Anthropic is the hosted
# fallback when no OpenAI-compatible provider is configured below.
#
# Source:
#   Anthropic Console > API Keys
#
# Format:
#   sk-ant-...
#
# Optional.
#
# Secret: YES
# Vercel Sensitive: YES
ANTHROPIC_API_KEY=


# -----------------------------------------------------------------------------
# AI — OPENAI-COMPATIBLE PROVIDER
# -----------------------------------------------------------------------------
#
# These allow the answering runtime to use providers exposing an
# OpenAI-compatible Chat Completions interface.
#
# Examples include:
#
#   Ollama
#   vLLM
#   compatible hosted providers
#   Gemini's OpenAI-compatible endpoint
#
# BASE_URL and MODEL must be configured together.


# Base URL of the provider.
#
# Local Ollama example:
#   http://127.0.0.1:11434/v1
#
# IMPORTANT:
#   127.0.0.1 on Vercel refers to the Vercel runtime itself, NOT your PC.
#
# Secret: NO
# Vercel Sensitive: NO
ASSISTANT_BASE_URL=


# Exact model identifier/tag exposed by the provider.
#
# Local example:
#   qwen2.5-coder:7b
#
# Secret: NO
# Vercel Sensitive: NO
ASSISTANT_MODEL=


# Optional API credential for a hosted OpenAI-compatible provider.
#
# Local Ollama normally leaves this blank.
#
# Secret: YES when populated
# Vercel Sensitive: YES
ASSISTANT_API_KEY=


# -----------------------------------------------------------------------------
# CONDITIONS / WEATHER
# -----------------------------------------------------------------------------

# Controls whether the automation runtime fetches external condition/weather
# readings from the current Open-Meteo adapter.
#
# Open-Meteo currently requires no API key for this integration, so there is
# no credential whose presence can act as the feature switch.
#
# Accepted enabled values in the current code:
#
#   1
#   true
#   yes
#
# Anything else disables it.
#
# Recommended while configuring infrastructure:
#
#   false
#
# Secret: NO
# Vercel Sensitive: NO
CONDITIONS_ENABLED=false


# -----------------------------------------------------------------------------
# LOCAL API PORT
# -----------------------------------------------------------------------------

# Used only by apps/api/dev.py when running the API locally.
#
# Default:
#   8787
#
# LOCAL:
#   PORT=8787
#
# VERCEL:
#   DO NOT CREATE THIS ENVIRONMENT VARIABLE.
#   Vercel manages the serverless runtime itself.
#
# Secret: NO
# Vercel Sensitive: NO
PORT=8787