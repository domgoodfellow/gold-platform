# One .gitignore for the workspace. create-next-app writes a second one inside apps/web;
# it was removed and its patterns folded in here, so there is one place to look.

# Dependencies
node_modules/
.pnp
.pnp.*
.pnpm-store/

# Build output
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo
next-env.d.ts

# Test output
coverage/

# Environment. Nothing with credentials in it is tracked, including the local Supabase
# keys that `pnpm db:start` prints into .env.test. The example file is the exception:
# it names the variables without carrying any value.
.env*
!.env.example

# Supabase CLI local state
supabase/.temp/

# Next.js re-creates these inside apps/web whenever an AI agent runs `next dev`
# (node_modules/next/dist/server/lib/generate-agent-files.js). Ignored so a regenerated
# copy never dirties the tree or gets committed by mistake.
apps/web/AGENTS.md
apps/web/CLAUDE.md

# Deploy
.vercel

# Misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# Python bytecode from apps/api.
__pycache__/
*.pyc
.pytest_cache

# Local working copy, not part of the document set.
docs/starting_conversation.txt
examples/