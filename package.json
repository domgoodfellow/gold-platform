{
  "name": "gold-platform",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "check": "pnpm -r --stream check && pnpm check:api",
    "check:api": "python -m pytest apps/api/tests -q",
    "check:ui-copy": "node scripts/check-ui-copy.mjs",
    "check:contract": "node scripts/contract-guard.mjs --base origin/main",
    "check:fast": "pnpm --filter @gold/web typecheck && pnpm --filter @gold/web lint && pnpm test:fast && pnpm --filter @gold/web build",
    "test:fast": "node scripts/test.mjs fast",
    "test:local": "node scripts/test.mjs local",
    "test:provider": "node scripts/test.mjs provider",
    "test:unit": "node scripts/test.mjs unit",
    "test:component": "node scripts/test.mjs component",
    "test:architecture": "node scripts/test.mjs architecture",
    "test:architecture:db": "node scripts/test.mjs architecture:db",
    "test:db": "node scripts/test.mjs db",
    "test:contract": "node scripts/test.mjs contract",
    "test:api": "node scripts/test.mjs api",
    "test:e2e": "node scripts/test.mjs e2e",
    "test:smoke": "node scripts/test.mjs smoke",
    "test:visual": "node scripts/test.mjs visual",
    "test:design": "node scripts/test.mjs design",
    "demo": "pnpm --filter @gold/web demo",
    "demo:fresh": "pnpm db:reset",
    "db:link": "supabase link",
    "db:migrations": "supabase migration list",
    "db:start": "supabase start",
    "db:reset": "supabase db reset && pnpm --filter @gold/web demo",
    "db:types": "supabase gen types typescript --local > apps/web/lib/db/database.types.ts",
    "db:types:remote": "supabase gen types typescript --linked > apps/web/lib/db/database.types.ts",
    "db:push:dry": "supabase db push --dry-run",
    "db:push": "supabase db push",
    "db:query:local": "supabase db query --local",
    "db:query:remote": "supabase db query --linked",
    "snippet:staff:local": "supabase db query --local --file supabase/snippets/add-platform-staff.sql",
    "snippet:staff:remote": "supabase db query --linked --file supabase/snippets/add-platform-staff.sql",
    "snippet:workflow-review:local": "supabase db query --local --file supabase/snippets/workflow-review-target.sql",
    "snippet:workflow-review:remote": "supabase db query --linked --file supabase/snippets/workflow-review-target.sql"
  },
  "devDependencies": {
    "supabase": "^2.22.6"
  }
}
