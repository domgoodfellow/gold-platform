{
  "name": "gold-platform",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "check": "pnpm -r --stream check && pnpm check:api",
    "check:api": "python -m pytest apps/api/tests -q",
    "demo": "pnpm --filter @gold/web demo",
    "demo:fresh": "pnpm db:reset && pnpm --filter @gold/web demo",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > apps/web/lib/db/database.types.ts",
    "db:push": "supabase db push"
  },
  "devDependencies": {
    "supabase": "^2.22.6"
  }
}
