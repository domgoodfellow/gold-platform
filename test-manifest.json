{
  "version": 1,
  "categories": {
    "unit": {
      "runner": "vitest",
      "dir": "apps/web/tests/unit",
      "requires": "none",
      "gate": true,
      "description": "One function or a small group, in-process, nothing external."
    },
    "component": {
      "runner": "vitest",
      "dir": "apps/web/tests/component",
      "requires": "none",
      "gate": true,
      "description": "A coherent UI component rendered in-process, outer boundaries faked."
    },
    "architecture-static": {
      "runner": "vitest",
      "dir": "apps/web/tests/architecture/static",
      "requires": "none",
      "gate": true,
      "description": "A codebase, build or dependency rule enforced by reading source or running the compiler. No database."
    },
    "architecture-db": {
      "runner": "vitest",
      "dir": "apps/web/tests/architecture/database",
      "requires": "database",
      "gate": true,
      "description": "A rule about the live schema, grants or roles, asked of the real local Postgres."
    },
    "database-integration": {
      "runner": "vitest",
      "dir": "apps/web/tests/integration/database",
      "requires": "database",
      "gate": true,
      "description": "Domain layer and/or policies against real local Supabase (Auth, Postgres, RLS)."
    },
    "offline-contract": {
      "runner": "vitest",
      "dir": "apps/web/tests/contract",
      "requires": "none",
      "gate": true,
      "description": "A provider or protocol shape checked offline from the web runtime: what an adapter sends a vendor and how it reads the reply, with fetch replaced."
    },
    "python-unit": {
      "runner": "pytest",
      "dir": "apps/api/tests/unit",
      "requires": "none",
      "gate": true,
      "description": "Python: one function or a small group."
    },
    "python-component": {
      "runner": "pytest",
      "dir": "apps/api/tests/component",
      "requires": "none",
      "gate": true,
      "description": "Python: a command or handler with its outer HTTP/database boundary faked."
    },
    "python-contract": {
      "runner": "pytest",
      "dir": "apps/api/tests/contract",
      "requires": "none",
      "gate": true,
      "description": "Python: a provider or protocol shape, checked offline."
    },
    "playwright-acceptance": {
      "runner": "playwright",
      "dir": "apps/web/e2e",
      "requires": "running-app",
      "gate": false,
      "description": "Browser journeys against the running app and seeded demo data."
    },
    "playwright-smoke": {
      "runner": "playwright",
      "dir": "apps/web/e2e/smoke",
      "requires": "running-app",
      "gate": false,
      "description": "The smallest deployed-shaped check: app answers, login renders, a session works, the shell loads."
    },
    "provider-contract": {
      "runner": "vitest",
      "dir": "apps/web/tests/provider-contract",
      "requires": "sandbox-credentials",
      "gate": false,
      "description": "A real vendor sandbox, called with credentials. Never in the default run; each test skips itself without its credentials. None exist yet."
    }
  },
  "tiers": {
    "fast": [
      "unit",
      "component",
      "architecture-static",
      "offline-contract",
      "python-unit",
      "python-component",
      "python-contract"
    ],
    "local": [
      "architecture-db",
      "database-integration"
    ],
    "e2e": [
      "playwright-acceptance"
    ],
    "smoke": [
      "playwright-smoke"
    ],
    "provider": [
      "provider-contract"
    ]
  },
